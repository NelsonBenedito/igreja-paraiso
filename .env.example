# =============================================================================
# Exemplo de variáveis de ambiente — Igreja Paraíso (Next.js)
# =============================================================================
# Copie este ficheiro para `.env.local` na raiz do projeto e preencha com os
# valores reais. O ficheiro `.env.local` não deve ser commitado (está no
# .gitignore). Variáveis com prefixo NEXT_PUBLIC_ são expostas ao browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (autenticação, base de dados, área de membros)
# -----------------------------------------------------------------------------
# URL do projeto e chave anónima — painel Supabase > Definições > API.
# Sem estes valores, login, /membros e páginas que usam Supabase não funcionam.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo

# -----------------------------------------------------------------------------
# Doações / Cotas (API Nest — links públicos Asaas)
# -----------------------------------------------------------------------------
# URL base da API que cria links de pagamento (sem barra no fim).
# POST {NEXT_PUBLIC_DONATIONS_API_BASE}/api/public/tenants/{slug}/links
#
# CORS no browser: o Nest só aceita origens registadas para o tenant na tabela
# tenant_public_web_origins (Configurações financeiras no admin). Não confundir
# com ADMIN_CORS_ORIGIN — o site público das cotas precisa da origem exacta
# (ex.: https://seu-dominio.com) registada lá.
NEXT_PUBLIC_DONATIONS_API_BASE=https://api.exemplo.com

# Identificador do tenant na API de doações (slug da igreja no Nest).
# Pode usar em alternativa NEXT_PUBLIC_TENANT_SLUG (o código aceita os dois).
NEXT_PUBLIC_DONATIONS_TENANT_SLUG=slug-da-igreja
# NEXT_PUBLIC_TENANT_SLUG=slug-da-igreja

# Referência para configurar o redirect de sucesso no Asaas ou na API Nest (não é lida pelo Next em runtime).
# Use o domínio público do site. A página da campanha reconhece ?obrigado=1 e mostra um banner de agradecimento.
# NEXT_PUBLIC_COTAS_PAGAMENTO_SUCESSO_URL=https://seu-dominio.com/cotas/campus?obrigado=1

# -----------------------------------------------------------------------------
# Modo “só campus” em produção (middleware)
# -----------------------------------------------------------------------------
# Quando está ativo em PRODUÇÃO (NODE_ENV=production), todas as rotas exceto
# /cotas/campus (e subcaminhos), /em-construcao, /api/*, /auth/callback, assets
# e _next redirecionam para a página “Em construção”.
# Útil enquanto este repositório não reflete o site completo.
# Valores: use exatamente "true" para ligar; omita ou use outro valor para desligar.
# NEXT_PUBLIC_ONLY_CAMPUS_LIVE=true

# -----------------------------------------------------------------------------
# YouTube (opcional — vídeo em destaque / revalidação)
# -----------------------------------------------------------------------------
# Chave da API YouTube Data v3. Pode ser só no servidor (YOUTUBE_API_KEY) ou
# também NEXT_PUBLIC_* se o componente no cliente precisar de ler.
# NEXT_PUBLIC_YOUTUBE_API_KEY=
# YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# API interna — revalidação ISR (opcional)
# -----------------------------------------------------------------------------
# Segredo partilhado com o serviço que chama POST /api/revalidate-youtube.
# Em produção, o endpoint exige este valor no header ou query acordado.
# REVALIDATION_SECRET=um-segredo-longo-e-aleatorio
